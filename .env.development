# Development — points at the COPY sheet's deployment, never the real one.
# The SECRET is NOT stored here: it is pasted once into the app at runtime
# (SetupView, WS3) and lives only in localStorage. Nothing secret belongs in a
# file that ends up in the repo.

# /exec URL of the COPY-sheet deployment. Filled in after WS0 deploys.
VITE_GAS_URL=

# WS2 runs entirely on mock data. Set to 'false' once WS3 lands the transport.
VITE_USE_MOCK=true
