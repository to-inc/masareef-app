# Production — the REAL sheet's deployment (set at cutover, WS6).
# Until then this stays empty so a stray production build cannot reach his file.
#
# Reminder: the /exec URL never changes once deployed — always redeploy via
# Manage deployments → Edit → New version, so Dad's Shortcuts are never touched.

VITE_GAS_URL=

